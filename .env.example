ENV=development
PORT=8000
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/dentelligence
LOG_LEVEL=INFO
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_MINUTES=10080
GEMINI_API_KEY=

# Comma-separated frontend origins allowed by CORS (defaults to localhost dev servers)
# CORS_ORIGINS=https://delligence.vercel.app
# PUBLIC_PORTAL_URL=https://delligence.vercel.app/portal

# Optional — Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
